Output .agents/tmp/pi-tree-names.gif

Set Shell "bash"
Set FontSize 13
Set Width 1600
Set Height 800
Set Padding 20

Type "/tmp/cly-test pt"
Enter
Sleep 3s

# Open history and select v1 (test data with mixed names)
Type "h"
Sleep 1s
Enter
Sleep 2s

# Scroll down through sessions
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 3s

Type "q"
Sleep 500ms
