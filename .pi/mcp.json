{
  "mcpServers": {
    "bubbles_docs": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/charmbracelet/bubbles"
      ],
      "command": "npx"
    },
    "bubbletea_docs": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/charmbracelet/bubbletea"
      ],
      "command": "npx"
    },
    "cobra_docs": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/spf13/cobra"
      ],
      "command": "npx"
    },
    "git": {
      "args": [
        "mcp-server-git"
      ],
      "command": "uvx",
      "type": "stdio"
    },
    "huh_docs": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/charmbracelet/huh"
      ],
      "command": "npx"
    },
    "lipgloss_docs": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/charmbracelet/lipgloss"
      ],
      "command": "npx"
    },
    "serena": {
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "$(pwd)",
        "--enable-web-dashboard",
        "false"
      ],
      "command": "uvx",
      "type": "stdio"
    },
    "vectorcode": {
      "command": "vectorcode-mcp-server",
      "type": "stdio"
    },
    "viper_docs": {
      "args": [
        "mcp-remote",
        "https://gitmcp.io/spf13/viper"
      ],
      "command": "npx"
    }
  }
}