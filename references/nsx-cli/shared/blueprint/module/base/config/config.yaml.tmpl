app:
  server:
    name: {{ .ProjectName }}

nsf:
  metrics:
    host: 0.0.0.0
    port: 2112
  flags:
    service-name: {{ .ProjectName }}
  logging:
    level: "debug"
    colorful: true
    timeFormat: "15:04:05"
    skipCaller: true
    redactedFields: "password,pass,token,secret"
    module: "github.com/NSXBet/{{ .ProjectName }}/"
    gorm:
      level: "warn"
      slowThreshold: 200
      ignoreRecordNotFoundError: true
