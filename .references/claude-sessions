@click.command(context_settings={"help_option_names": ["-h", "--help"]})
@click.argument("query", required=False)
@click.option("-i", "--interactive", is_flag=True, help="Interactive selection mode")
@click.option("-r", "--resume", is_flag=True, help="Resume session")
@click.option("--fork-session", is_flag=True, help="Fork session")
@click.option("--show", is_flag=True, help="Show full conversation")
@click.option("--export", is_flag=True, help="Export to .paid format")
@click.option("--project", help="Filter by project path")
@click.option("--since", help="Filter by date (e.g., 'yesterday', '2 days ago')")
@click.option("--limit", default=20, help="Limit number of results")
@click.option("--format", "format_type", default="compact", type=click.Choice(["compact", "markdown", "json"]))
@click.option("-c", "--copy", is_flag=True, help="Copy session ID to clipboard")
@click.option("--generate-completions", is_flag=True, hidden=True, help="Generate Fish completions")
def cli(query, interactive, resume, fork_session, show, export, project, since, limit, format_type, copy, generate_completions):
    """Search and manage Claude Code sessions.

    \b
    Examples:
      cs                              List recent sessions
      cs --limit 5                    List 5 most recent sessions
      cs zellij                       Search for "zellij" in sessions
      cs ffd4f550                     Show session info (partial ID works)
      cs ffd4f550 --show              Display full conversation
      eval (cs ffd4f550 -r)           Resume session (cd to project + resume)
      eval (cs ffd4f550 --fork-session) Fork session in its directory
      cs --since "2 days ago"         List sessions from last 2 days
      cs --project DotFiles           Filter by project name
    """
    # Handle completion generation
    if generate_completions:
        print_completions()
        return

    if query:
        # Try to resolve as session ID first
        resolved_id = resolve_session_id(query)
        if resolved_id:
            # Query is a session ID - show info or perform action
            if resume:
                # Verify session file exists
                session_file = get_session_file(resolved_id)
                if not session_file:
                    console.print(f"[red]❌ Session file not found for {resolved_id[:8]}[/red]")
                    return

                project_dir = get_session_project(resolved_id)
                if not project_dir:
                    console.print("[red]❌ Could not find project directory in history[/red]")
                    return

                # Check if project directory exists
                project_path = Path(project_dir)
                if not project_path.exists():
                    console.print(f"[red]❌ Project directory does not exist: {project_dir}[/red]")
                    return

                # Execute resume command
                console.print(f"[cyan]📂 Resuming session {resolved_id[:8]} in {project_dir}[/cyan]")
                os.chdir(project_dir)
                os.execvp("claude", ["claude", "--resume", resolved_id])

            elif fork_session:
                # Verify session file exists
                session_file = get_session_file(resolved_id)
                if not session_file:
                    console.print(f"[red]❌ Session file not found for {resolved_id[:8]}[/red]")
                    return

                project_dir = get_session_project(resolved_id)
                if not project_dir:
                    console.print("[red]❌ Could not find project directory in history[/red]")
                    return

                # Check if project directory exists
                project_path = Path(project_dir)
                if not project_path.exists():
                    console.print(f"[red]❌ Project directory does not exist: {project_dir}[/red]")
                    return

                # Execute fork command
                console.print(f"[cyan]📂 Forking session {resolved_id[:8]} in {project_dir}[/cyan]")
                os.chdir(project_dir)
                os.execvp("claude", ["claude", "--fork", resolved_id])
            elif show:
                show_session_conversation(resolved_id)
            elif export:
                console.print("[yellow]Export not yet implemented[/yellow]")
            else:
                # Default: show info
                show_session_info(resolved_id)
        else:
            # Not a session ID - treat as search query
            sessions = search_sessions(query, limit)
            if interactive:
                # TODO: Interactive selection
                console.print("[yellow]Interactive mode not yet implemented[/yellow]")
            else:
                print_session_list(sessions, format_type)
    else:
        # No query - list sessions
        sessions = list_sessions(limit, since, project)
        if interactive:
            # TODO: Interactive selection
            console.print("[yellow]Interactive mode not yet implemented[/yellow]")
        else:
            print_session_list(sessions, format_type)


if __name__ == "__main__":
    cli()
