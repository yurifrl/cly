# 1Password-backed env file for cly.
# Generate the resolved .env via:   task envs:op
# Account: my.1password.com (personal)   Vault: Private   Item: cly

# Apple Developer ID identity used by pkg/notify/swift/build.sh to codesign
# the embedded cly-notifier.app bundle.
CLY_NOTIFIER_SIGN_ID="op://Private/cly/APPLE_DEVELOPER_ID"
